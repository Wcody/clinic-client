# 平台本地运行端口号
VITE_PORT = 8868

# 开发环境读取配置文件路径
VITE_PUBLIC_PATH = /

# 接口请求前缀
VITE_API_BASE_URL = /ams/api/v1

# 下载请求前缀
VITE_MVC_BASE_URL = /ams/mvc/v1

# 开发环境代理配置
# VITE_PROXY = [[VITE_API_BASE_URL,"http://localhost:3000"],["/upload","http://localhost:3300/upload"]]
VITE_PROXY = [["/ams","http://localhost:8700/ams"]]

# 开发环境路由历史模式（Hash模式传"hash"、HTML5模式传"h5"、Hash模式带base参数传"hash,base参数"、HTML5模式带base参数传"h5,base参数"）
VITE_ROUTER_HISTORY = "hash"
